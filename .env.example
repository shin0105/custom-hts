# -------------------------------------- 한투 (Korean Investment Securities) -------------------------------------- #
# Get your API keys from: https://apiportal.koreainvestment.com/
HANTU_API_KEY=your_hantu_api_key_here
HANTU_API_SECRET=your_hantu_api_secret_here
HANTU_BANK_ACCOUNT=your_hantu_account_number_here
HANTU_ACCOUNT_NUMBER=your_hantu_account_number_here

# -------------------------------- Open DART (Korean Financial Supervisory Service) -------------------------------------- #
# Get your API key from: https://opendart.fss.or.kr/
DART_API_KEY=your_dart_api_key_here

# -------------------------------- Supabase -------------------------------------- #
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

